NEXT_PUBLIC_SITE_URL=****
SAMPLE_PAX=****
SAMPLE_AO=****
SAMPLE_REGION=****
ENVIRONMENT=****
BIGQUERY_PROJECT_ID=****
BIGQUERY_DATASET=****
BIGQUERY_CLIENT_EMAIL=****
BIGQUERY_PRIVATE_KEY=****
OAUTH_CLIENT_ID=****
OAUTH_CLIENT_SECRET=****
OAUTH_REDIRECT_URI=****
AUTH_PROVIDER_URL=****
SESSION_SECRET=****

# DuckDB Phase 1 foundation (disabled by default; no credentials here).
DUCKDB_ENABLED=false
# Capability flags inherit DUCKDB_ENABLED when unset. An explicit false cuts
# back only that capability; DUCKDB_ENABLED=false always wins globally.
DUCKDB_SEARCH_ENABLED=
DUCKDB_EVENTS_ENABLED=
DUCKDB_STATS_PAX_ENABLED=
DUCKDB_STATS_REGION_ENABLED=
DUCKDB_STATS_AREA_ENABLED=
DUCKDB_STATS_SECTOR_ENABLED=
DUCKDB_STATS_AO_ENABLED=
# Auth-capability routing inherits DUCKDB_ENABLED when unset; explicit false
# keeps allowlist, identity, and region-permission lookups on BigQuery.
DUCKDB_AUTH_ENABLED=
# Shadow compares sampled DuckDB reads while BigQuery remains the served result
# for capabilities that are still disabled.
# The implementation bounds the rate to 10% and timeout to 1 second.
DUCKDB_SHADOW_ENABLED=false
DUCKDB_SHADOW_SAMPLE_RATE=0
DUCKDB_SHADOW_TIMEOUT_MS=500
DUCKDB_GCS_BUCKET=
DUCKDB_GCS_PREFIX=releases
DUCKDB_GCS_CONTROL_OBJECT=current.json
DUCKDB_CACHE_DIR=/tmp/pax-vault-duckdb
DUCKDB_REFRESH_TTL_MS=300000
DUCKDB_MAX_LKG_AGE_MS=3600000
# Example DuckDB memory setting; validate it against active+staging database
# peak measurements for the selected Cloud Run instance size.
DUCKDB_MEMORY_LIMIT=384MB
# Hard compressed-download budgets, including golden artifacts. The current
# PAX producer artifact is ~329MB compressed (~323MB pv_events); these limits
# fit that artifact but do not establish uncompressed/runtime memory capacity.
DUCKDB_MAX_RELEASE_BYTES=536870912
DUCKDB_MAX_OBJECT_BYTES=402653184

# PAX deployment path overrides (apply only for the f3-analytics deployment;
# generic application defaults above remain environment-specific).
# DUCKDB_GCS_PREFIX=pax-vault/releases
# DUCKDB_GCS_CONTROL_OBJECT=pax-vault/current.json
